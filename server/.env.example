# Server Configuration
PORT=3001

# The Movie Database API
TMDB_API_KEY=your_tmdb_api_key_here

# Admin Authentication
ADMIN_PASSWORD=your_admin_password_here
SESSION_SECRET=your_long_random_session_secret_here
# JWT_EXPIRES_IN=8h

# Model Context Protocol (MCP) Server API Key (Admin Port 3001 only)
# Leave unset to disable the /api/mcp endpoint
MCP_API_KEY=your_long_random_mcp_api_key_here

# Database
DATABASE_PATH=./database.sqlite

# File Upload
UPLOAD_DIR=./uploads
